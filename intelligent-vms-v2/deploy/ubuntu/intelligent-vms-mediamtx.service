[Unit]
Description=Intelligent VMS media gateway (MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vms
Group=vms
EnvironmentFile=/etc/intelligent-vms/vms.env
ExecStart=/usr/local/bin/mediamtx /etc/intelligent-vms/mediamtx.yml
Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
