# Copy to .env and fill in. NEVER commit the filled file.
VMS_ENVIRONMENT=development

# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (token_urlsafe output is required for VMS_MEDIA_AUTH_HOOK_SECRET because it
# is embedded in the gateway's hook URL.)
VMS_SECRET_KEY=
VMS_DB_PASSWORD=

# Media gateway administration (control API -> MediaMTX Control API).
VMS_MEDIA_GATEWAY_USER=vms-control
VMS_MEDIA_GATEWAY_PASSWORD=

# Media gateway admission hook (MediaMTX -> control API). >= 32 characters.
VMS_MEDIA_AUTH_HOOK_SECRET=

# Public URLs browsers will use to reach the media gateway.
VMS_PUBLIC_WEBRTC_URL=http://localhost:8889
VMS_PUBLIC_HLS_URL=http://localhost:8888

# In production set explicit hosts and origins (startup refuses "*").
# control-api-internal and localhost are appended automatically by compose.
VMS_TRUSTED_HOSTS=vms.example.com
VMS_CORS_ORIGINS=https://vms.example.com
