# Copy to .env and fill in. NEVER commit the filled file.
VMS_ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VMS_SECRET_KEY=
VMS_DB_PASSWORD=

# Public URLs browsers will use to reach the media gateway.
VMS_PUBLIC_WEBRTC_URL=http://localhost:8889
VMS_PUBLIC_HLS_URL=http://localhost:8888

# In production set explicit hosts and origins (startup refuses "*").
VMS_TRUSTED_HOSTS=vms.example.com
VMS_CORS_ORIGINS=https://vms.example.com
