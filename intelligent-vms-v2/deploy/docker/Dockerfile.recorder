FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY packages/shared-contracts /app/packages/shared-contracts
COPY services/control-api /app/services/control-api
COPY services/recording-service /app/services/recording-service

RUN pip install --no-cache-dir ./packages/shared-contracts \
 && pip install --no-cache-dir ./services/control-api \
 && pip install --no-cache-dir ./services/recording-service

RUN useradd --system --uid 10001 vms && mkdir -p /data && chown vms:vms /data
USER vms

ENV VMS_DATA_ROOT=/data
CMD ["python", "-m", "recorder.worker"]
