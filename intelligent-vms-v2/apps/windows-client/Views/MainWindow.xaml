<Window x:Class="IntelligentVms.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IntelligentVms.Client.Views"
        Title="Intelligent VMS" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Window.InputBindings>
        <!-- Operator shortcuts. Documented in docs/user-guides/operator.md. -->
        <KeyBinding Key="F1" Command="{Binding ShowLiveCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ShowPlaybackCommand}"/>
        <KeyBinding Key="F3" Command="{Binding ShowAlarmsCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SnapshotCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ManualRecordCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DetachMonitorCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Live"     Command="{Binding ShowLiveCommand}"     Style="{DynamicResource ToolbarButton}"/>
                    <Button Content="Playback" Command="{Binding ShowPlaybackCommand}" Style="{DynamicResource ToolbarButton}"/>
                    <Button Content="Alarms"   Command="{Binding ShowAlarmsCommand}"   Style="{DynamicResource ToolbarButton}"/>
                    <Separator Margin="10,0"/>
                    <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                              DisplayMemberPath="Name" Width="120"/>
                    <Button Content="Detach monitor" Command="{Binding DetachMonitorCommand}"
                            Style="{DynamicResource ToolbarButton}" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
                    <Button Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource ToolbarButton}"/>
                    <ToggleButton Content="{Binding NotificationBadge}"
                                  IsChecked="{Binding NotificationsOpen}"
                                  Style="{DynamicResource ToolbarToggle}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusBarText}" Margin="12,6" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"/>
        </Border>

        <views:CameraTree DockPanel.Dock="Left" Width="260"
                          DataContext="{Binding CameraTree}"/>

        <Grid>
            <ContentControl Content="{Binding CurrentView}"/>
            <views:NotificationCenter HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Width="340" Margin="0,8,8,0"
                                      DataContext="{Binding Notifications}"
                                      Visibility="{Binding DataContext.NotificationsVisibility,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
    </DockPanel>
</Window>
