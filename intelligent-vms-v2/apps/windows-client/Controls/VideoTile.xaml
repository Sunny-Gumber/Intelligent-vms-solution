<!--
  A single video tile.

  The error overlay is part of the tile, not a modal dialog: a dead camera
  must never interrupt an operator watching the other fifteen.
-->
<UserControl x:Class="IntelligentVms.Client.Controls.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
  <Grid Background="Black">
    <vlc:VideoView x:Name="Player" />

    <!-- Status strip -->
    <Border VerticalAlignment="Top" Background="#99000000" Padding="6,2">
      <TextBlock Foreground="White">
        <Run Text="{Binding CameraName, FallbackValue='— empty —'}" />
        <Run Text=" · " />
        <Run Text="{Binding Status}" />
      </TextBlock>
    </Border>

    <!-- Per-tile error overlay -->
    <Border Background="#CC301010" Padding="12"
            Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="⚠" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
