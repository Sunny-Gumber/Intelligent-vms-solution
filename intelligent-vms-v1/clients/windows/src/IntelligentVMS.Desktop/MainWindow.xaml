<Window x:Class="IntelligentVMS.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:IntelligentVMS.Desktop"
 Title="Intelligent VMS Desktop" Width="1360" Height="820" MinWidth="1024" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left"><TextBlock Text="Intelligent VMS Desktop" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ServerStateText" Text="No server configured" Foreground="{StaticResource TextMuted}"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="760">
     <TextBlock x:Name="AuthMethodText" Text="Configure a VMS server to sign in." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <PasswordBox x:Name="TokenBox" Width="220" Margin="4" ToolTip="Existing VMS access token" Visibility="Collapsed"/>
      <Button x:Name="ManualSignInButton" Content="Sign in with access token" Click="SignIn_Click" Visibility="Collapsed"/>
      <Button x:Name="OrganizationSignInButton" Content="Sign in with your organization" Click="OrganizationSignIn_Click" Visibility="Collapsed"/>
      <Button x:Name="CancelAuthButton" Content="Cancel" Click="CancelAuth_Click" Visibility="Collapsed"/>
      <CheckBox x:Name="RememberCheck" Content="Remember me" VerticalAlignment="Center" Margin="8,0"/>
      <Button x:Name="LogoutButton" Content="Logout" Click="Logout_Click" IsEnabled="False"/>
     </StackPanel>
     <TextBlock x:Name="AuthStatusText" Text="" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8" Margin="0,0,8,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Authorized cameras" FontWeight="SemiBold" Margin="4"/><TreeView x:Name="CameraTree" Grid.Row="1" SelectedItemChanged="CameraTree_SelectedItemChanged" MouseDoubleClick="CameraTree_MouseDoubleClick" Background="#121922" Foreground="{StaticResource TextPrimary}"/></Grid>
   </Border>
   <TabControl x:Name="MainTabs" Grid.Column="1" Background="{StaticResource PanelBackground}" SelectionChanged="MainTabs_SelectionChanged">
    <TabItem x:Name="LiveTab" Header="Live">
     <Grid Margin="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="Layout" VerticalAlignment="Center" Margin="4"/>
        <Button Content="1" Tag="1" Click="Layout_Click" ToolTip="1-view"/>
        <Button Content="4" Tag="4" Click="Layout_Click" ToolTip="2×2"/>
        <Button Content="9" Tag="9" Click="Layout_Click" ToolTip="3×3"/>
        <Button Content="16" Tag="16" Click="Layout_Click" ToolTip="4×4 architecture"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <ComboBox x:Name="StreamRoleCombo" Width="105" ToolTip="Active-tile stream role"/>
        <Button Content="Apply role" Click="ApplyRole_Click"/>
        <Button Content="Assign selected camera" Click="AssignSelectedCamera_Click"/>
       </StackPanel>
       <TextBlock x:Name="LiveSelectionText" Text="Select a tile, then assign an authorized camera." VerticalAlignment="Center" Margin="12,4" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="4">
       <Grid x:Name="LiveGridHost" Background="Black"/>
      </Border>
      <Border Grid.Row="2" Margin="4" Padding="6" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
       <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
         <TextBlock Text="PTZ · active live tile" FontWeight="SemiBold"/>
         <UniformGrid Rows="3" Columns="3" Width="132" Margin="0,4,0,0">
          <Border/><Button x:Name="PtzUpButton" Content="▲" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="0,1,0"/><Border/>
          <Button x:Name="PtzLeftButton" Content="◀" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="-1,0,0"/>
          <Button x:Name="PtzStopButton" Content="■" Click="PtzStop_Click" ToolTip="Stop PTZ movement"/>
          <Button x:Name="PtzRightButton" Content="▶" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="1,0,0"/>
          <Border/><Button x:Name="PtzDownButton" Content="▼" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="0,-1,0"/><Border/>
         </UniformGrid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0">
         <TextBlock Text="Optical zoom"/>
         <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button x:Name="PtzZoomOutButton" Content="−" Width="44" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="0,0,-1"/>
          <Button x:Name="PtzZoomInButton" Content="+" Width="44" PreviewMouseLeftButtonDown="PtzMove_MouseDown" PreviewMouseLeftButtonUp="PtzMove_MouseUp" LostMouseCapture="PtzMove_LostMouseCapture" Tag="0,0,1"/>
         </StackPanel>
         <TextBlock Text="Speed" Margin="0,6,0,0"/>
         <ComboBox x:Name="PtzSpeedCombo" Width="100">
          <ComboBoxItem Content="Slow" Tag="0.35"/><ComboBoxItem Content="Medium" Tag="0.65"/><ComboBoxItem Content="Fast" Tag="1.0"/>
         </ComboBox>
        </StackPanel>
        <TextBlock x:Name="PtzStatusText" Text="PTZ unavailable" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="18,0,4,0" TextWrapping="Wrap"/>
       </DockPanel>
      </Border>
      <TextBlock x:Name="GridStatusText" Grid.Row="3" Margin="4" Foreground="{StaticResource TextMuted}" Text="1-view · 0 live"/>
     </Grid>
    </TabItem>
    <TabItem Header="Cameras"><TextBlock Margin="16" TextWrapping="Wrap" Text="Camera inventory remains server-authoritative. Select an authorized camera from the navigation tree."/></TabItem>
    <TabItem x:Name="PlaybackTab" Header="Playback">
     <Grid Margin="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock x:Name="PlaybackCameraText" Text="Select one authorized camera." VerticalAlignment="Center" Margin="4"/>
        <DatePicker x:Name="PlaybackDatePicker" Width="150" Margin="8,2" SelectedDateChanged="PlaybackDate_SelectedDateChanged"/>
        <Button Content="Load recording day" Click="PlaybackLoad_Click"/>
       </StackPanel>
       <TextBlock x:Name="PlaybackDayStateText" Text="No day loaded" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,4"/>
      </DockPanel>
      <local:PlaybackMediaView x:Name="PlaybackMedia" Grid.Row="1" Margin="4" MinHeight="280"/>
      <Grid Grid.Row="2" Margin="4">
       <Canvas x:Name="PlaybackTimelineCanvas" Height="48" Background="#080B10" MouseLeftButtonDown="PlaybackTimeline_MouseLeftButtonDown"/>
      </Grid>
      <DockPanel Grid.Row="3" Margin="4">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="PlaybackPlayButton" Content="Play" Click="PlaybackPlay_Click"/>
        <Button x:Name="PlaybackPauseButton" Content="Pause" Click="PlaybackPause_Click"/>
        <Button x:Name="PlaybackStopButton" Content="Stop" Click="PlaybackStop_Click"/>
        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="10,0,4,0"/>
        <ComboBox x:Name="PlaybackRateCombo" Width="70" SelectionChanged="PlaybackRate_SelectionChanged"><ComboBoxItem Content="1×" Tag="1"/></ComboBox>
       </StackPanel>
       <TextBlock x:Name="PlaybackPositionText" Text="Position: —" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <TextBlock x:Name="PlaybackStatusText" Text="Ready" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4">
       <Button Content="Mark clip start" Click="PlaybackMarkStart_Click"/>
       <Button Content="Mark clip end" Click="PlaybackMarkEnd_Click"/>
       <TextBlock x:Name="PlaybackClipText" Text="Clip: not selected" VerticalAlignment="Center" Margin="8,0"/>
       <Button x:Name="PlaybackExportButton" Content="Export MP4" Click="PlaybackExport_Click" IsEnabled="False"/>
      </StackPanel>
     </Grid>
    </TabItem>
    <TabItem x:Name="EventsTab" Header="Events" Visibility="Collapsed"><TextBlock Margin="16" TextWrapping="Wrap" Text="Event history is visible only when advertised by the connected server. Native event workstation controls are a later milestone."/></TabItem>
    <TabItem Header="Settings"><ScrollViewer><StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">
     <TextBlock Text="Client-local server profiles" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="These settings do not modify VMS server configuration." Foreground="{StaticResource TextMuted}"/>
     <ComboBox x:Name="ProfileCombo" DisplayMemberPath="DisplayName" SelectionChanged="ProfileCombo_SelectionChanged" Width="430" HorizontalAlignment="Left"/>
     <TextBlock Text="Display name"/><TextBox x:Name="DisplayNameBox" Width="430" HorizontalAlignment="Left"/>
     <TextBlock Text="Scheme"/><ComboBox x:Name="SchemeCombo" Width="150" HorizontalAlignment="Left"><ComboBoxItem Content="https"/><ComboBoxItem Content="http"/></ComboBox>
     <TextBlock Text="Hostname / IP"/><TextBox x:Name="HostBox" Width="430" HorizontalAlignment="Left"/>
     <TextBlock Text="Port"/><TextBox x:Name="PortBox" Width="150" HorizontalAlignment="Left"/>
     <StackPanel Orientation="Horizontal"><Button Content="New profile" Click="NewProfile_Click"/><Button Content="Save profile" Click="SaveProfile_Click"/><Button Content="Test connection" Click="TestConnection_Click"/></StackPanel>
     <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" Margin="4"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Diagnostics"><StackPanel Margin="16"><TextBlock Text="Safe client diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,10"/><Button Content="Export redacted diagnostics" HorizontalAlignment="Left" Click="ExportDiagnostics_Click"/></StackPanel></TabItem>
   </TabControl>
  </Grid>
 </Grid>
</Window>
