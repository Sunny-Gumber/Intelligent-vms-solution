<UserControl x:Class="IntelligentVMS.Desktop.LiveTileView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="True">
 <Border x:Name="TileBorder" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="#0B0F14" Margin="2">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Background="#CC18212C" LastChildFill="True">
    <Button x:Name="FocusButton" DockPanel.Dock="Right" Content="Focus" Click="Focus_Click" Padding="7,3" ToolTip="Focus selected camera"/>
    <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear" Click="Clear_Click" Padding="7,3" ToolTip="Clear this tile"/>
    <TextBlock x:Name="CameraText" Text="Empty tile" Margin="7,5" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
   </DockPanel>
   <local:LiveMediaView x:Name="Media" Grid.Row="1" xmlns:local="clr-namespace:IntelligentVMS.Desktop"/>
   <DockPanel Grid.Row="2" Background="#CC18212C">
    <TextBlock x:Name="RoleText" DockPanel.Dock="Right" Margin="7,4" Foreground="{StaticResource TextMuted}"/>
    <TextBlock x:Name="StatusText" Margin="7,4" Foreground="{StaticResource TextMuted}"/>
   </DockPanel>
  </Grid>
 </Border>
</UserControl>